<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <!-- ISP.Lanyard: Inspector des Content-Elements "Ticketbestellung". Überschreibbar im Sitepackage über eine Datei mit
         product-name="ISP.Lanyard" original="NodeTypes/Content/OrderForm". -->
    <file original="NodeTypes/Content/OrderForm" product-name="ISP.Lanyard" source-language="de" target-language="en" datatype="plaintext">
        <body>
            <trans-unit id="groups.lanyard" xml:space="preserve">
                <source>Ticketbestellung</source>
                <target>Ticket order</target>
            </trans-unit>
            <trans-unit id="properties.eventIdentifier" xml:space="preserve">
                <source>Veranstaltung</source>
                <target>Event</target>
            </trans-unit>
            <trans-unit id="properties.eventIdentifier.help" xml:space="preserve">
                <source>Erscheint hier nur, wenn im Backend-Modul ein Kurzschlüssel für die Veranstaltung gepflegt ist.</source>
                <target>Only appears here if a short key has been set for the event in the backend module.</target>
            </trans-unit>
            <trans-unit id="properties.eventIdentifier.placeholder" xml:space="preserve">
                <source>Veranstaltung wählen</source>
                <target>Select event</target>
            </trans-unit>
            <trans-unit id="properties.failurePage" xml:space="preserve">
                <source>Seite nach abgebrochener Zahlung</source>
                <target>Page after cancelled payment</target>
            </trans-unit>
            <trans-unit id="properties.failurePage.help" xml:space="preserve">
                <source>Für Online-Zahlung: Hierhin geht es, wenn die Zahlung abgebrochen wurde oder fehlgeschlagen ist. Leer: eine einfache Seite von Lanyard.</source>
                <target>For online payment: shown when the payment was cancelled or failed. Empty: a plain Lanyard page.</target>
            </trans-unit>
            <trans-unit id="properties.privacyPage" xml:space="preserve">
                <source>Datenschutzerklärung</source>
                <target>Privacy policy</target>
            </trans-unit>
            <trans-unit id="properties.successPage" xml:space="preserve">
                <source>Seite nach erfolgreicher Zahlung</source>
                <target>Page after successful payment</target>
            </trans-unit>
            <trans-unit id="properties.successPage.help" xml:space="preserve">
                <source>Für Online-Zahlung: Hierhin geht es nach der Zahlung, auch wenn die Bestätigung des Zahlungsanbieters noch aussteht – die Bestätigung kommt dann per E-Mail. Leer: eine einfache Seite von Lanyard.</source>
                <target>For online payment: shown after paying, also while the provider has not yet confirmed the payment – the confirmation then follows by email. Empty: a plain Lanyard page.</target>
            </trans-unit>
            <trans-unit id="ui.label" xml:space="preserve">
                <source>Ticketbestellung</source>
                <target>Ticket order</target>
            </trans-unit>
        </body>
    </file>
</xliff>
