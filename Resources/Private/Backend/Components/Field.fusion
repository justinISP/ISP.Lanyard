##
# Formularfeld der Backend-Formulare.
#
# Name wird zu moduleArguments[input][<name>]. Beschriftung und Hilfe
# kommen aus ISP.Lanyard/Backend.xlf (labelId, helpId – Standard
# setup.field.<name> und setup.help.<name>), label und help sind der
# Rückfall.
#
prototype(ISP.Lanyard:Backend.Field) < prototype(Neos.Fusion:Component) {

    name = ''
    label = ''
    help = null
    value = ''
    error = null

    # text, date, number, textarea oder checkbox
    type = 'text'
    required = false

    # Übersetzungs-IDs, falls gleichnamige Felder verschiedene Texte
    # brauchen (z. B. "title" bei Event und Tag)
    labelId = ${'setup.field.' + this.name}
    helpId = ${'setup.help.' + this.name}

    id = ${'lanyardField-' + this.name}
    fieldName = ${'moduleArguments[input][' + this.name + ']'}

    renderer = afx`
        <div class={props.error ? 'lanyardBackendField lanyardBackendField--error' : 'lanyardBackendField'}>
            <label @if.notCheckbox={props.type != 'checkbox'} for={props.id}>
                <ISP.Lanyard:Backend.T id={props.labelId} fallback={props.label} />{props.required ? ' *' : ''}
            </label>
            <input
                @if.input={props.type == 'text' || props.type == 'date' || props.type == 'number'}
                class="lanyardBackendInput"
                type={props.type}
                id={props.id}
                name={props.fieldName}
                value={props.value}
                required={props.required}
            />
            <textarea @if.textarea={props.type == 'textarea'} class="lanyardBackendInput" id={props.id} name={props.fieldName} rows="3">{String.htmlSpecialChars(props.value)}</textarea>
            <div @if.checkbox={props.type == 'checkbox'}>
                <label class="lanyardBackendCheck" for={props.id}>
                    <input type="checkbox" id={props.id} name={props.fieldName} value="1" checked={props.value == '1'} />
                    <ISP.Lanyard:Backend.T id={props.labelId} fallback={props.label} />
                </label>
            </div>
            <span @if.hasHelp={props.help} class="lanyardBackendFieldHelp">
                <ISP.Lanyard:Backend.T id={props.helpId} fallback={props.help} />
            </span>
            <span @if.hasError={props.error} class="lanyardBackendFieldError">{String.htmlSpecialChars(props.error)}</span>
        </div>
    `
}

##
# Icon im Stil der Demo (Strichzeichnung, 16 px).
#
prototype(ISP.Lanyard:Backend.Icon) < prototype(Neos.Fusion:Component) {
    name = ''

    paths = Neos.Fusion:DataStructure {
        arrowLeft = 'M19 12H5M12 19l-7-7 7-7'
        ban = 'M12 22a10 10 0 1 1 0-20 10 10 0 0 1 0 20zM4.9 4.9l14.2 14.2'
        cash = 'M2 6h20v12H2zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z'
        check = 'M20 6L9 17l-5-5'
        download = 'M12 3v12M7 10l5 5 5-5M5 21h14'
        edit = 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z'
        eye = 'M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z'
        filter = 'M3 5h18l-7 8v6l-4 2v-8z'
        plus = 'M12 5v14M5 12h14'
        refresh = 'M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5'
        ticket = 'M3 7h18v3a2 2 0 0 0 0 4v3H3v-3a2 2 0 0 0 0-4z'
        trash = 'M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6'
        x = 'M18 6L6 18M6 6l12 12'
    }

    renderer = afx`
        <svg class="lanyardBackendIcon" viewBox="0 0 24 24" aria-hidden="true"><path d={props.paths[props.name]} /></svg>
    `
}

##
# Button oder Link im Neos-Stil. Mit href ein Link, sonst ein
# Submit-Button. variant: primary (grün), accent (blau), danger (rot).
#
prototype(ISP.Lanyard:Backend.Button) < prototype(Neos.Fusion:Component) {
    href = null
    variant = null
    icon = null
    title = null
    content = ''

    class = ${'lanyardBackendButton' + (this.variant ? ' lanyardBackendButton--' + this.variant : '')}

    renderer = afx`
        <a @if.isLink={props.href} href={props.href} class={props.class} title={props.title}>
            <ISP.Lanyard:Backend.Icon @if.hasIcon={props.icon} name={props.icon} />
            {props.content}
        </a>
        <button @if.isButton={!props.href} type="submit" class={props.class} title={props.title}>
            <ISP.Lanyard:Backend.Icon @if.hasIcon={props.icon} name={props.icon} />
            {props.content}
        </button>
    `
}

##
# Quadratischer Aktions-Button in Zeilenhöhe, für die letzte
# Tabellenspalte.
#
prototype(ISP.Lanyard:Backend.IconButton) < prototype(Neos.Fusion:Component) {
    href = ''
    icon = 'eye'
    # Tooltip aus ISP.Lanyard/Backend.xlf, label als Rückfall
    labelId = ''
    label = ''

    title = ${I18n.id(this.labelId).package('ISP.Lanyard').source('Backend').value(this.label).locale('de').translate()}

    renderer = afx`
        <a href={props.href} class="lanyardBackendIconButton" title={props.title} aria-label={props.title}>
            <ISP.Lanyard:Backend.Icon name={props.icon} />
        </a>
    `
}

##
# Button, der per POST mit CSRF-Token abschickt, z. B. zum Löschen.
# square: als quadratischer Aktions-Button in der Tabelle.
#
prototype(ISP.Lanyard:Backend.PostButton) < prototype(Neos.Fusion:Component) {
    uri = ''
    label = ''
    labelId = ''
    icon = 'trash'
    variant = 'danger'
    square = false

    title = ${I18n.id(this.labelId).package('ISP.Lanyard').source('Backend').value(this.label).locale('de').translate()}

    renderer = afx`
        <form method="post" action={props.uri} class="lanyardBackendInlineForm">
            <ISP.Lanyard:Backend.CsrfField />
            <button @if.square={props.square} type="submit" class={'lanyardBackendIconButton lanyardBackendIconButton--' + props.variant} title={props.title} aria-label={props.title}>
                <ISP.Lanyard:Backend.Icon name={props.icon} />
            </button>
            <ISP.Lanyard:Backend.Button @if.wide={!props.square} variant={props.variant} icon={props.icon}>
                <ISP.Lanyard:Backend.T id={props.labelId} fallback={props.label} />
            </ISP.Lanyard:Backend.Button>
        </form>
    `
}
